<Window x:Class="CafeArian.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="شروع کار | کافه آرین" Icon="/Assets/arian-logo.png"
        Width="480" Height="340" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft" Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}">
    <Border Background="White" CornerRadius="14" Padding="24" Margin="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="نام شما چیست؟" FontSize="23" FontWeight="Bold"/>
            <TextBlock Text="این نام در برنامه نمایش داده می‌شود و از تنظیمات قابل تغییر است. دفعهٔ بعد برنامه مستقیم باز می‌شود."
                       TextWrapping="Wrap" Margin="0,10,0,16"/>
            <TextBlock Text="نام کاربر"/>
            <TextBox x:Name="UsernameBox" AutomationProperties.Name="نام کاربر" Height="38" Margin="0,5,0,12" MaxLength="80"/>
            <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap"/>
            <Button Content="شروع کار" Style="{StaticResource PrimaryButton}" Height="43" Click="Submit_Click" IsDefault="True"/>
        </StackPanel></ScrollViewer>
    </Border>
</Window>
