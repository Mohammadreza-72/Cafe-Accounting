<Window x:Class="CafeArian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="کافه آرین | مدیریت فروش" Icon="/Assets/arian-logo.png"
        Width="1360" Height="820" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Bottom" Text="نسخه آفلاین • داده‌ها روی همین دستگاه"
                           Foreground="#9DA2A5" FontSize="11" Margin="15,12,15,22" TextAlignment="Center"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border x:Name="BrandPanel" Background="White" CornerRadius="12" Margin="14,12,14,8" Height="90" ClipToBounds="True">
                        <Image Stretch="Uniform">
                            <Image.Source>
                                <CroppedBitmap SourceRect="90,280,1070,640">
                                    <CroppedBitmap.Source>
                                        <BitmapImage UriSource="/Assets/arian-logo.png"/>
                                    </CroppedBitmap.Source>
                                </CroppedBitmap>
                            </Image.Source>
                        </Image>
                    </Border>
                    <TextBlock Text="ARIAN CAFFE" Foreground="White" FontSize="17" FontWeight="Bold"
                               TextAlignment="Center" FlowDirection="LeftToRight" Margin="0,0,0,22"/>
                    <Button x:Name="DashboardNav" Style="{StaticResource NavButton}" Content="داشبورد" Click="Dashboard_Click"/>
                    <Button x:Name="SalesNav" Style="{StaticResource NavButton}" Content="فروش سریع" Click="Sales_Click"/>
                    <Button x:Name="ProductsNav" Style="{StaticResource NavButton}" Content="کالا و انبار" Click="Products_Click"/>
                    <Button x:Name="RecipesNav" Style="{StaticResource NavButton}" Content="دستور تهیه" Click="Recipes_Click"/>
                    <Button x:Name="BatchesNav" Style="{StaticResource NavButton}" Content="بچ و انقضا" Click="Batches_Click"/>
                    <Button x:Name="InventoryNav" Style="{StaticResource NavButton}" Content="خرید و انبار" Click="Inventory_Click"/>
                    <Button x:Name="SuppliersNav" Style="{StaticResource NavButton}" Content="تأمین‌کنندگان" Click="Suppliers_Click"/>
                    <Button x:Name="CustomersNav" Style="{StaticResource NavButton}" Content="مشتریان" Click="Customers_Click"/>
                    <Button x:Name="DiscountsNav" Style="{StaticResource NavButton}" Content="کدهای تخفیف" Click="Discounts_Click"/>
                    <Button x:Name="HistoryNav" Style="{StaticResource NavButton}" Content="فاکتورها" Click="History_Click"/>
                    <Button x:Name="FinanceNav" Style="{StaticResource NavButton}" Content="مالی و گزارش" Click="Finance_Click"/>
                    <Button x:Name="AccountsNav" Style="{StaticResource NavButton}" Content="حساب‌ها و کارتخوان‌ها" Click="Accounts_Click"/>
                    <Button x:Name="UsersNav" Style="{StaticResource NavButton}" Content="کاربران" Click="Users_Click"/>
                    <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="تنظیمات و پشتیبان" Click="Settings_Click"/>
                    <Button x:Name="DiagnosticsNav" Style="{StaticResource NavButton}" Content="عیب‌یابی" Click="Diagnostics_Click"/>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid x:Name="ContentPanel" Grid.Column="1" Margin="18,12,18,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="OperationStatus" Grid.Row="2" Visibility="Collapsed" Background="White" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                <TextBlock x:Name="OperationStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Border>
            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right">
                    <TextBlock x:Name="PageTitle" Text="داشبورد" FontSize="23" FontWeight="Bold"/>
                    <TextBlock x:Name="PageSubtitle" Text="مرور وضعیت امروز کافه" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ClockText" DockPanel.Dock="Left" HorizontalAlignment="Left"
                           Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="CurrentUserText" DockPanel.Dock="Left" Margin="14,0,0,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
            </DockPanel>

            <ScrollViewer x:Name="DashboardPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <UniformGrid Columns="4" Margin="0,0,0,18">
                        <Border Background="White" CornerRadius="12" Margin="4" Padding="20">
                            <StackPanel><TextBlock Text="فروش امروز" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="TodaySalesText" FontSize="23" FontWeight="Bold" Margin="0,12,0,0"/></StackPanel>
                        </Border>
                        <Border x:Name="ExpenseCard" Background="White" CornerRadius="12" Margin="4" Padding="20">
                            <StackPanel><TextBlock Text="هزینه امروز" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="TodayExpensesText" FontSize="23" FontWeight="Bold" Margin="0,12,0,0"/></StackPanel>
                        </Border>
                        <Border x:Name="ProfitCard" Background="White" CornerRadius="12" Margin="4" Padding="20">
                            <StackPanel><TextBlock Text="سود تخمینی امروز" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="TodayProfitText" FontSize="23" FontWeight="Bold" Margin="0,12,0,0"/></StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" Margin="4" Padding="20">
                            <StackPanel><TextBlock Text="کالاهای کم‌موجودی" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="LowStockText" FontSize="23" FontWeight="Bold" Margin="0,12,0,0"/></StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Background="White" CornerRadius="12" Padding="25">
                        <StackPanel>
                            <TextBlock Text="شروع سریع" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="محصولات کافه را تعریف کنید، موجودی را با ثبت خرید افزایش دهید و فروش را از صفحه فروش سریع انجام دهید."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                            <WrapPanel Margin="0,18,0,0">
                                <Button x:Name="QuickSaleButton" Content="فروش جدید  F1" Style="{StaticResource PrimaryButton}" Click="Sales_Click"/>
                                <Button x:Name="QuickProductButton" Content="تعریف محصول" Click="Products_Click"/>
                                <Button x:Name="QuickPurchaseButton" Content="ثبت خرید" Click="Inventory_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="22" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="فروش هفت روز اخیر" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                <ItemsControl x:Name="WeeklySalesChart">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding Amount, StringFormat=N0}" FontSize="11"
                                                           TextAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                                <Grid Height="120">
                                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="5,5,0,0"
                                                            Width="28" Height="{Binding BarHeight}" VerticalAlignment="Bottom"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Label}" TextAlignment="Center" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="22" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="هشدار موجودی" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                <ItemsControl x:Name="LowStockList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Text="{Binding Stock, StringFormat=موجودی {0:N0}}"
                                                           DockPanel.Dock="Left" Foreground="{StaticResource AccentBrush}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoLowStockText" Text="موردی ثبت نشده است."
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="پرفروش‌ترین محصولات هفت روز اخیر" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <DataGrid x:Name="TopProductsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" Height="245">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="محصول" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity, StringFormat=N2}" Width="145"/>
                                    <DataGridTextColumn Header="فروش (تومان)" Binding="{Binding Revenue, StringFormat=N0}" Width="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="SalesPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="جستجوی نام یا بارکد" Foreground="{StaticResource MutedBrush}" Margin="3,0,3,3"/>
                            <TextBox x:Name="SearchBox" Height="44" ToolTip="نام یا بارکد محصول" TextChanged="SearchBox_TextChanged"
                                     KeyDown="SearchBox_KeyDown"/>
                        </StackPanel>
                        <DockPanel Grid.Row="1" LastChildFill="False" Margin="5,12,5,12">
                            <TextBlock Text="محصولات" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ProductsHint" DockPanel.Dock="Left" Margin="14,5,0,0"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="ProductsWrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="75"/><RowDefinition Height="1.5*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="فاکتور جاری" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Left" Content="حذف قلم" Click="RemoveItem_Click" Padding="8,4"/>
                            <Button DockPanel.Dock="Left" Content="−" Click="DecreaseItem_Click" Padding="8,4"/>
                            <Button DockPanel.Dock="Left" Content="+" Click="IncreaseItem_Click" Padding="8,4"/>
                        </DockPanel>
                        <DataGrid x:Name="CartList" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  Margin="0,6" CanUserAddRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="محصول" Width="*" MinWidth="125">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding ProductName}" TextWrapping="Wrap" ToolTip="{Binding ProductName}" Padding="4"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity}" Width="45" MinWidth="45"/>
                                <DataGridTextColumn Header="مبلغ" Binding="{Binding Total, StringFormat=N0}" Width="85" MinWidth="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="روش پرداخت" Margin="3,0"/>
                            <ComboBox x:Name="PaymentModeBox" SelectedIndex="0" Margin="3,3" Height="32" SelectionChanged="PaymentMode_Changed">
                                <ComboBoxItem Content="تمام مبلغ نقدی"/>
                                <ComboBoxItem Content="تمام مبلغ کارتخوان"/>
                                <ComboBoxItem Content="تمام مبلغ کارت به کارت"/>
                                <ComboBoxItem Content="پرداخت ترکیبی"/>
                            </ComboBox>
                            <UniformGrid x:Name="PaymentAmountsPanel" Columns="3" Margin="0,3,0,0">
                                <StackPanel><TextBlock Text="نقدی" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="CashBox" ToolTip="مانده نقدی (خودکار)" Text="0" IsReadOnly="True"/></StackPanel>
                                <StackPanel><TextBlock Text="کارتخوان" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="CardBox" Text="0" TextChanged="PaymentBox_TextChanged"/></StackPanel>
                                <StackPanel><TextBlock Text="کارت به کارت" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="TransferBox" Text="0" TextChanged="PaymentBox_TextChanged"/></StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <TextBlock Text="کارتخوان انتخابی (اختیاری)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="3,2"/>
                                <TextBlock Text="حساب مقصد کارت به کارت (اختیاری)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="3,2"/>
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <ComboBox x:Name="PosDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          Margin="3,3" Height="32" ToolTip="کارتخوان ثبت‌شده (اختیاری)"/>
                                <ComboBox x:Name="TransferBankBox" DisplayMemberPath="BankName" SelectedValuePath="Id"
                                          Margin="3,3" Height="32" ToolTip="حساب مقصد کارت به کارت (اختیاری)"/>
                            </UniformGrid>
                            <Expander x:Name="SaleDetailsExpander" Header="مشتری، تخفیف و مالیات" Margin="3,8">
                                <StackPanel>
                                    <TextBlock Text="موبایل مشتری (اختیاری)" Margin="3,5,3,0"/>
                                    <TextBox x:Name="MobileBox" TextChanged="MobileBox_TextChanged"/>
                                    <TextBlock x:Name="MobileStatusText" TextWrapping="Wrap"/>
                                    <DockPanel Margin="3,3"><TextBlock Text="جمع اقلام"/><TextBlock x:Name="SubtotalText" DockPanel.Dock="Left"/></DockPanel>
                                    <TextBlock Text="تخفیف (تومان)" Margin="3,5,3,0"/>
                                    <TextBox x:Name="DiscountBox" Text="0" TextChanged="DiscountBox_TextChanged"/>
                                    <TextBlock Text="کد تخفیف (جایگزین تخفیف دستی)" Margin="3,5,3,0"/>
                                    <TextBox x:Name="CouponBox" TextChanged="CouponBox_TextChanged"/>
                                    <TextBlock x:Name="CouponHint" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="3,8">
                                        <CheckBox x:Name="TaxApplyBox" Content="اعمال مالیات" IsChecked="True" Checked="ChargeApply_Changed" Unchecked="ChargeApply_Changed" Margin="0,0,12,0"/>
                                        <CheckBox x:Name="FeeApplyBox" Content="اعمال کارمزد" IsChecked="True" Checked="ChargeApply_Changed" Unchecked="ChargeApply_Changed"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="ChargePreviewText" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="PaymentHint" TextWrapping="Wrap" FontSize="12" Margin="3,0,3,5"/>
                                <DockPanel Margin="3,0,3,7"><TextBlock Text="مبلغ نهایی" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock x:Name="FinalText" DockPanel.Dock="Left" Foreground="{StaticResource AccentBrush}"
                                               FontSize="18" FontWeight="Bold"/></DockPanel>
                                <Button Content="ثبت فاکتور  F5" Style="{StaticResource PrimaryButton}" Height="48"
                                        AutomationProperties.Name="ثبت فاکتور" Click="Checkout_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ProductsPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <WrapPanel x:Name="CatalogToolbar" Margin="0,0,0,8">
                    <StackPanel><TextBlock Text="جستجوی نام، بارکد یا SKU"/><TextBox x:Name="CatalogSearchBox" Width="240" TextChanged="CatalogSearch_Changed"/></StackPanel>
                    <Button x:Name="NewProductButton" Content="کالای جدید" Click="NewProduct_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
                    <Button Content="ثبت خرید و مدیریت موجودی" Click="Inventory_Click" VerticalAlignment="Bottom"/>
                </WrapPanel>
                <ScrollViewer x:Name="ProductEditor" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <WrapPanel><TextBlock Text="تعریف یا ویرایش محصول" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="بازگشت به فهرست" Click="ProductList_Click"/></WrapPanel>
                        <UniformGrid Columns="3" Margin="0,12,0,0">
                            <StackPanel><TextBlock Text="نام"/><TextBox x:Name="ProductNameBox" AutomationProperties.Name="نام محصول"/></StackPanel>
                            <StackPanel><TextBlock Text="نوع"/>
                                <ComboBox x:Name="ProductTypeBox" SelectedIndex="0" Margin="3,5" Height="38" SelectionChanged="ProductType_Changed"
                                          ToolTip="فروشی ساده برای کالای بسته‌بندی؛ آماده‌شونده برای محصول دارای دستور تهیه؛ بچ‌دار برای کالای دارای تاریخ انقضا">
                                    <ComboBoxItem Content="فروشی ساده" Tag="1"/>
                                    <ComboBoxItem Content="ماده اولیه" Tag="2"/>
                                    <ComboBoxItem Content="آماده‌شونده" Tag="3"/>
                                    <ComboBoxItem Content="بچ‌دار/انقضا" Tag="4"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel><TextBlock Text="دسته‌بندی"/><ComboBox x:Name="ProductCategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="38" Margin="3,5"/></StackPanel>
                            <StackPanel><TextBlock Text="قیمت فروش"/><TextBox x:Name="ProductSaleBox" Text="0"/></StackPanel>
                            <StackPanel><TextBlock Text="بهای خرید"/><TextBox x:Name="ProductCostBox" Text="0"/></StackPanel>
                            <StackPanel><TextBlock Text="واحد"/><TextBox x:Name="ProductUnitBox" Text="عدد"/></StackPanel>
                            <StackPanel><TextBlock Text="حداقل موجودی"/><TextBox x:Name="ProductMinimumBox" Text="0"/></StackPanel>
                            <StackPanel><TextBlock Text="بارکد (خودکار)"/><TextBox x:Name="ProductBarcodeBox"/></StackPanel>
                            <StackPanel><TextBlock Text="SKU (خودکار)"/><TextBox x:Name="ProductSkuBox"/></StackPanel>
                        </UniformGrid>
                        <WrapPanel Margin="3,8,0,0">
                            <StackPanel><TextBlock Text="ورود اولیه / اصلاح مثبت (افزودن به موجودی)"/><TextBox x:Name="ProductStockBox" Text="0" Width="220"/></StackPanel>
                            <Button Content="ثبت خرید از تأمین‌کننده" Click="Inventory_Click" Margin="16,15,3,3"/>
                            <Button Content="تنظیم دستور تهیه" Click="ProductRecipe_Click" Margin="3,15"/>
                        </WrapPanel>
                        <TextBlock Text="ورود اولیه بدهی یا پرداخت خرید ثبت نمی‌کند؛ برای خرید از تأمین‌کننده دکمهٔ خرید را بزنید. بارکد و SKU خالی خودکار ساخته می‌شوند. موجودی آماده‌شونده از دستور تهیه و کالای بچ‌دار از بچ‌های معتبر محاسبه می‌شود."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="3,6,3,0"/>
                        <WrapPanel Margin="0,4,0,0">
                            <StackPanel><TextBlock Text="دسته‌بندی جدید" Margin="3,0"/><TextBox x:Name="NewCategoryBox" Width="200"/></StackPanel>
                            <Button Content="افزودن دسته‌بندی" Click="AddCategory_Click" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="ذخیره محصول" Style="{StaticResource PrimaryButton}" Click="SaveProduct_Click"/>
                            <Button Content="فرم جدید" Click="NewProduct_Click"/>
                            <Button Content="غیرفعال‌سازی انتخاب‌شده" Click="DeactivateProduct_Click"/>
                            <Button Content="چاپ لیبل محصول انتخاب‌شده" Click="PrintProductLabel_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="ProductStatusText" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="3,4,3,0"/>
                    </StackPanel>
                </Border>
                </ScrollViewer>
                <DataGrid x:Name="ProductGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionChanged="ProductGrid_SelectionChanged" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*" MinWidth="180"/>
                        <DataGridTextColumn Header="نوع" Binding="{Binding ProductTypeName}" Width="120"/>
                        <DataGridTextColumn Header="قابل فروش" Binding="{Binding Stock}" Width="90"/>
                        <DataGridTextColumn Header="موجودی ثبت‌شده" Binding="{Binding OnHand}" Width="125"/>
                        <DataGridTextColumn Header="قیمت فروش" Binding="{Binding SalePrice, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="بهای پایه" Binding="{Binding CostPrice, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="دسته" Binding="{Binding Category}" Width="110"/>
                        <DataGridTextColumn Header="واحد" Binding="{Binding UnitName}" Width="70"/>
                        <DataGridTextColumn Header="بارکد" Binding="{Binding Barcode}" Width="130"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
                        <DataGridTextColumn Header="حداقل" Binding="{Binding MinimumStock}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="RecipesPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="مواد مصرفی هر واحد محصول" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="برای محصول آماده‌شونده یا یخچالی، مقدار ماده اولیه برای هر واحد را تعریف کنید."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
                        <UniformGrid Columns="3">
                            <StackPanel><TextBlock Text="محصول تولیدی / یخچالی"/>
                                <ComboBox x:Name="RecipeProductBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectionChanged="RecipeProduct_SelectionChanged" Height="38" Margin="3,5"/></StackPanel>
                            <StackPanel><TextBlock Text="ماده اولیه"/>
                                <ComboBox x:Name="RecipeIngredientBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          Height="38" Margin="3,5"/></StackPanel>
                            <StackPanel><TextBlock Text="مقدار برای یک واحد محصول"/>
                                <TextBox x:Name="RecipeQuantityBox" ToolTip="مثلاً 18 گرم یا 0.2 لیتر، مطابق واحد ماده اولیه"/></StackPanel>
                        </UniformGrid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="افزودن یا ویرایش ماده" Style="{StaticResource PrimaryButton}" Click="SaveRecipeItem_Click"/>
                            <Button Content="حذف ماده انتخاب‌شده" Click="RemoveRecipeItem_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="RecipeCostText" Grid.Row="1" FontSize="17" FontWeight="SemiBold" Margin="5,0,5,12"/>
                <DataGrid x:Name="RecipeGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="RecipeItem_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ماده اولیه" Binding="{Binding IngredientName}" Width="*"/>
                        <DataGridTextColumn Header="مقدار" Binding="{Binding QuantityDisplay}" Width="150"/>
                        <DataGridTextColumn Header="میانگین بهای واحد" Binding="{Binding UnitCost, StringFormat=N0}" Width="170"/>
                        <DataGridTextColumn Header="بهای مصرف" Binding="{Binding LineCost, StringFormat=N0}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="BatchesPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ثبت بچ محصول یخچالی" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="موجودی قابل فروش از بچ‌های دارای تاریخ معتبر محاسبه می‌شود. بارکد بچ برای اسکن اختیاری است."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
                        <UniformGrid Columns="4">
                            <StackPanel><TextBlock Text="محصول"/><ComboBox x:Name="BatchProductBox" DisplayMemberPath="Name" Height="38" Margin="3,5"/></StackPanel>
                            <StackPanel><TextBlock Text="شماره بچ"/><TextBox x:Name="BatchNumberBox"/></StackPanel>
                            <StackPanel><TextBlock Text="بارکد بچ (اختیاری)"/><TextBox x:Name="BatchBarcodeBox"/></StackPanel>
                            <StackPanel><TextBlock Text="منبع / تولیدکننده"/><TextBox x:Name="BatchSourceBox"/></StackPanel>
                            <StackPanel><TextBlock Text="تاریخ تولید"/><DatePicker x:Name="BatchProducedPicker" Margin="3,5" Height="38"/></StackPanel>
                            <StackPanel><TextBlock Text="تاریخ انقضا"/><DatePicker x:Name="BatchExpiryPicker" Margin="3,5" Height="38"/></StackPanel>
                            <StackPanel><TextBlock Text="مقدار"/><TextBox x:Name="BatchQuantityBox"/></StackPanel>
                            <StackPanel><TextBlock Text="بهای واحد برای ورود مستقیم (تومان)"/><TextBox x:Name="BatchCostBox"/></StackPanel>
                        </UniformGrid>
                        <CheckBox x:Name="BatchProductionCheck" Content="تولید از دستور تهیه؛ بهای واحد از مواد محاسبه شود" Margin="3,8"/>
                        <Button Content="ثبت بچ و افزایش موجودی" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                Margin="0,10,0,0" Click="RegisterBatch_Click"/>
                    </StackPanel>
                </Border>
                <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button Content="ثبت ضایعات بچ انتخاب‌شده" Click="DiscardBatch_Click"/>
                    <Button Content="چاپ لیبل بچ انتخاب‌شده" Click="PrintBatchLabel_Click"/>
                    <TextBlock Text="برای بچ منقضی یا آسیب‌دیده، مقدار باقی‌مانده را از موجودی خارج کنید."
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="12,0"/>
                </WrapPanel>
                <DataGrid x:Name="BatchGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="محصول" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="بچ" Binding="{Binding BatchNumber}" Width="130"/>
                        <DataGridTextColumn Header="بارکد" Binding="{Binding Barcode}" Width="130"/>
                        <DataGridTextColumn Header="منبع" Binding="{Binding Source}" Width="150"/>
                        <DataGridTextColumn Header="تولید" Binding="{Binding ProducedAt}" Width="110"/>
                        <DataGridTextColumn Header="انقضا" Binding="{Binding ExpiresAt}" Width="110"/>
                        <DataGridTextColumn Header="مقدار" Binding="{Binding Quantity}" Width="90"/>
                        <DataGridTextColumn Header="بهای واحد" Binding="{Binding UnitCost, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <ScrollViewer x:Name="InventoryPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                          <WrapPanel><TextBlock Text="ثبت خرید و ورود موجودی" FontSize="18" FontWeight="SemiBold"/>
                              <Button Content="بازگشت به کالاها" Click="Products_Click" Margin="16,0,0,0"/></WrapPanel>
                          <TextBlock Text="موجودی ثبت‌شده شامل بچ‌های منقضی است؛ ستون قابل فروش فقط مقدار قابل‌عرضه را نشان می‌دهد. موجودی محصول آماده‌شونده از مواد اولیهٔ دستور تهیه محاسبه می‌شود."
                                     TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                        <UniformGrid Columns="4" Margin="0,12,0,0">
                            <StackPanel><TextBlock Text="محصول"/><ComboBox x:Name="PurchaseProductBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="3,5" Height="38"/></StackPanel>
                            <StackPanel><TextBlock Text="تأمین‌کننده"/><ComboBox x:Name="PurchaseSupplierBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="3,5" Height="38"/></StackPanel>
                            <StackPanel><TextBlock Text="شماره سند"/><TextBox x:Name="PurchaseInvoiceBox"/></StackPanel>
                            <StackPanel><TextBlock Text="مقدار"/><TextBox x:Name="PurchaseQuantityBox"/></StackPanel>
                            <StackPanel><TextBlock Text="قیمت واحد"/><TextBox x:Name="PurchaseCostBox"/></StackPanel>
                            <StackPanel><TextBlock Text="پرداخت خرید"/><ComboBox x:Name="PurchasePaymentBox" SelectedIndex="0" Height="38" Margin="3,5"><ComboBoxItem Content="نسیه" Tag="Unpaid"/><ComboBoxItem Content="نقدی" Tag="Cash"/><ComboBoxItem Content="بانک" Tag="Bank"/></ComboBox></StackPanel>
                            <StackPanel><TextBlock Text="حساب، فقط برای بانک"/><ComboBox x:Name="PurchaseBankBox" DisplayMemberPath="BankName" SelectedValuePath="Id" Height="38" Margin="3,5"/></StackPanel>
                        </UniformGrid>
                        <WrapPanel Margin="0,8,0,4">
                            <Button Content="افزودن قلم" Click="AddPurchaseLine_Click"/>
                            <Button Content="حذف قلم انتخاب‌شده" Click="RemovePurchaseLine_Click"/>
                            <Button Content="ثبت سند خرید و افزایش موجودی" Style="{StaticResource PrimaryButton}" Click="Purchase_Click"/>
                        </WrapPanel>
                        <DataGrid x:Name="PurchaseLinesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" Height="115">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="محصول" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="مقدار" Binding="{Binding Quantity}" Width="110"/>
                                <DataGridTextColumn Header="بهای واحد" Binding="{Binding UnitCost, StringFormat=N0}" Width="125"/>
                                <DataGridTextColumn Header="جمع" Binding="{Binding Total, StringFormat=N0}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="اصلاح موجودی یا ثبت ضایعات" FontSize="16" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,8,0,0">
                            <StackPanel><TextBlock Text="محصول یا ماده اولیه" Margin="3,0"/><ComboBox x:Name="AdjustmentProductBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      Width="240" Height="38" Margin="3,5"/></StackPanel>
                            <StackPanel><TextBlock Text="تغییر مقدار؛ ضایعات با عدد منفی" Margin="3,0"/><TextBox x:Name="AdjustmentDeltaBox" Width="210"/></StackPanel>
                            <StackPanel><TextBlock Text="علت اصلاح" Margin="3,0"/><TextBox x:Name="AdjustmentReasonBox" Width="240"/></StackPanel>
                            <Button Content="ثبت اصلاح" Click="Adjustment_Click" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TabControl Height="320">
                    <TabItem Header="موجودی">
                        <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="محصول" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="موجودی ثبت‌شده" Binding="{Binding OnHand}" Width="145"/>
                                <DataGridTextColumn Header="قابل فروش" Binding="{Binding Stock}" Width="130"/>
                                <DataGridTextColumn Header="حداقل مجاز" Binding="{Binding MinimumStock}" Width="140"/>
                                <DataGridTextColumn Header="میانگین بهای خرید" Binding="{Binding AverageCost, StringFormat=N0}" Width="170"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="سوابق خرید">
                        <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="تسویه خرید انتخاب‌شده" VerticalAlignment="Center" Margin="4"/>
                            <TextBox x:Name="PurchasePaymentAmountBox" Width="130" ToolTip="مبلغ تسویه به تومان"/>
                            <ComboBox x:Name="SettlementKindBox" Width="110" Height="38" Margin="3,5" SelectedIndex="0"><ComboBoxItem Content="نقدی" Tag="Cash"/><ComboBoxItem Content="بانک" Tag="Bank"/></ComboBox>
                            <ComboBox x:Name="SettlementBankBox" Width="170" Height="38" Margin="3,5" DisplayMemberPath="BankName" SelectedValuePath="Id" ToolTip="حساب برای تسویه بانکی"/>
                            <Button x:Name="SettlePurchaseButton" Content="ثبت پرداخت" Click="PayPurchase_Click"/>
                        </WrapPanel>
                        <DataGrid x:Name="PurchaseGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="شماره" Binding="{Binding Id}" Width="90"/>
                                <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="170"/>
                                <DataGridTextColumn Header="تأمین‌کننده" Binding="{Binding Supplier}" Width="*"/>
                                <DataGridTextColumn Header="شماره سند" Binding="{Binding InvoiceNumber}" Width="150"/>
                                <DataGridTextColumn Header="مبلغ" Binding="{Binding Total, StringFormat=N0}" Width="140"/>
                                <DataGridTextColumn Header="پرداخت" Binding="{Binding PaymentKind}" Width="90"/>
                                <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding Paid, StringFormat=N0}" Width="110"/>
                                <DataGridTextColumn Header="باقی‌مانده" Binding="{Binding Due, StringFormat=N0}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="SuppliersPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ثبت تأمین‌کننده" FontSize="18" FontWeight="SemiBold"/>
                        <UniformGrid Columns="3" Margin="0,12,0,0">
                            <StackPanel><TextBlock Text="نام"/><TextBox x:Name="SupplierNameBox"/></StackPanel>
                            <StackPanel><TextBlock Text="موبایل (اختیاری)"/><TextBox x:Name="SupplierMobileBox"/></StackPanel>
                            <StackPanel><TextBlock Text="شرکت"/><TextBox x:Name="SupplierCompanyBox"/></StackPanel>
                            <StackPanel><TextBlock Text="نشانی"/><TextBox x:Name="SupplierAddressBox"/></StackPanel>
                            <StackPanel><TextBlock Text="یادداشت"/><TextBox x:Name="SupplierNotesBox"/></StackPanel>
                        </UniformGrid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="ثبت تأمین‌کننده" Style="{StaticResource PrimaryButton}" Click="AddSupplier_Click"/>
                            <Button Content="غیرفعال‌سازی انتخاب‌شده" Click="DeactivateSupplier_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="SupplierGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="145"/>
                        <DataGridTextColumn Header="شرکت" Binding="{Binding Company}" Width="180"/>
                        <DataGridTextColumn Header="نشانی" Binding="{Binding Address}" Width="220"/>
                        <DataGridTextColumn Header="یادداشت" Binding="{Binding Notes}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="CustomersPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ثبت مشتری" FontSize="18" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel><TextBlock Text="نام مشتری" Margin="3,0"/><TextBox x:Name="CustomerNameBox" Width="220" AutomationProperties.Name="نام مشتری"/></StackPanel>
                            <StackPanel><TextBlock Text="شماره موبایل" Margin="3,0"/><TextBox x:Name="CustomerMobileBox" Width="180" AutomationProperties.Name="شماره موبایل مشتری"/></StackPanel>
                            <Button Content="ذخیره مشتری" Style="{StaticResource PrimaryButton}" Margin="3,20,3,3" Click="SaveCustomer_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="CustomerStatusText" Foreground="{StaticResource AccentBrush}" Margin="3,4,3,0"/>
                        <WrapPanel Margin="0,8,0,0">
                            <StackPanel><TextBlock Text="جستجو در مشتریان" Margin="3,0"/><TextBox x:Name="CustomerSearchBox" Width="230" AutomationProperties.Name="جستجوی نام یا موبایل" TextChanged="CustomerSearch_TextChanged"/></StackPanel>
                            <Button Content="سوابق خرید مشتری" Margin="3,20,3,3" Click="CustomerHistory_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="CustomerGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نام" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="180"/>
                        <DataGridTextColumn Header="تعداد خرید" Binding="{Binding TotalOrders}" Width="120"/>
                        <DataGridTextColumn Header="جمع خرید" Binding="{Binding TotalPurchase, StringFormat=N0}" Width="150"/>
                        <DataGridTextColumn Header="جمع تخفیف" Binding="{Binding TotalDiscount, StringFormat=N0}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="DiscountsPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="تعریف کد تخفیف" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="کد تخفیف با تخفیف دستی ترکیب نمی‌شود. استفادهٔ فاکتور لغوشده از سقف مصرف کد کم می‌شود."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
                        <UniformGrid Columns="4">
                            <StackPanel><TextBlock Text="کد"/><TextBox x:Name="DiscountCodeBox"/></StackPanel>
                            <StackPanel><TextBlock Text="نوع"/><ComboBox x:Name="DiscountTypeBox" SelectedIndex="0" Margin="3,5" Height="38">
                                <ComboBoxItem Content="درصدی"/><ComboBoxItem Content="مبلغ ثابت"/>
                            </ComboBox></StackPanel>
                            <StackPanel><TextBlock Text="مقدار (درصد یا تومان)"/><TextBox x:Name="DiscountValueBox"/></StackPanel>
                            <StackPanel><TextBlock Text="حداقل خرید (تومان)"/><TextBox x:Name="DiscountMinimumBox" Text="0"/></StackPanel>
                            <StackPanel><TextBlock Text="شروع اعتبار (اختیاری)"/><DatePicker x:Name="DiscountStartPicker" Margin="3,5" Height="38"/></StackPanel>
                            <StackPanel><TextBlock Text="پایان اعتبار (اختیاری)"/><DatePicker x:Name="DiscountEndPicker" Margin="3,5" Height="38"/></StackPanel>
                            <StackPanel><TextBlock Text="حداکثر استفاده (اختیاری)"/><TextBox x:Name="DiscountLimitBox"/></StackPanel>
                        </UniformGrid>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="ثبت کد" Style="{StaticResource PrimaryButton}" Click="AddDiscount_Click"/>
                            <Button Content="غیرفعال‌سازی کد انتخاب‌شده" Click="DeactivateDiscount_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="DiscountGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="130"/>
                        <DataGridTextColumn Header="نوع" Binding="{Binding TypeName}" Width="100"/>
                        <DataGridTextColumn Header="مقدار" Binding="{Binding Value, StringFormat=N0}" Width="100"/>
                        <DataGridTextColumn Header="حداقل خرید" Binding="{Binding MinimumPurchase, StringFormat=N0}" Width="120"/>
                        <DataGridTextColumn Header="شروع" Binding="{Binding StartDate}" Width="110"/>
                        <DataGridTextColumn Header="پایان" Binding="{Binding EndDate}" Width="110"/>
                        <DataGridTextColumn Header="سقف" Binding="{Binding UsageLimit}" Width="90"/>
                        <DataGridTextColumn Header="استفاده" Binding="{Binding UsedCount}" Width="90"/>
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,12">
                    <StackPanel><TextBlock Text="جستجوی شماره فاکتور، تاریخ، مشتری یا مبلغ" Margin="3,0"/>
                    <TextBox x:Name="HistorySearchBox" Width="300" AutomationProperties.Name="جستجوی فاکتور"
                             TextChanged="HistorySearch_TextChanged"/></StackPanel>
                    <Button Content="چاپ فاکتور انتخاب‌شده" Click="PrintSelected_Click"/>
                    <Button x:Name="CancelSelectedButton" Content="لغو فاکتور انتخاب‌شده" Click="CancelSelected_Click"/>
                    <Button Content="خروجی CSV" Click="ExportSales_Click"/>
                </WrapPanel>
                <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="شماره" Binding="{Binding InvoiceNumber}" Width="135"/>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="160"/>
                        <DataGridTextColumn Header="مشتری" Binding="{Binding Customer}" Width="*"/>
                        <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="135"/>
                        <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="125"/>
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <ScrollViewer x:Name="FinancePage" Grid.Row="1" Visibility="Collapsed">
                <StackPanel>
                    <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ثبت هزینه" FontSize="18" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,12,0,0">
                                <StackPanel><TextBlock Text="دستهٔ هزینه" Margin="3,0"/><ComboBox x:Name="ExpenseCategoryBox" Width="160" Height="38" Margin="3,5" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
                                <StackPanel><TextBlock Text="شرح هزینه" Margin="3,0"/><TextBox x:Name="ExpenseDescriptionBox" Width="300"/></StackPanel>
                                <StackPanel><TextBlock Text="مبلغ (تومان)" Margin="3,0"/><TextBox x:Name="ExpenseAmountBox" Width="180"/></StackPanel>
                                <StackPanel><TextBlock Text="روش پرداخت" Margin="3,0"/><ComboBox x:Name="ExpensePaymentBox" Width="140" SelectedIndex="0" Height="38" Margin="3,5"><ComboBoxItem Content="نقدی" Tag="Cash"/><ComboBoxItem Content="بانک" Tag="Bank"/></ComboBox></StackPanel>
                                <StackPanel><TextBlock Text="حساب پرداخت بانکی" Margin="3,0"/><ComboBox x:Name="ExpenseBankBox" Width="180" DisplayMemberPath="BankName" SelectedValuePath="Id" Height="38" Margin="3,5"/></StackPanel>
                                <Button Content="ثبت هزینه" Style="{StaticResource PrimaryButton}" Click="Expense_Click" VerticalAlignment="Bottom"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <StackPanel><TextBlock Text="دستهٔ جدید هزینه" Margin="3,0"/><TextBox x:Name="NewExpenseCategoryBox" Width="220"/></StackPanel>
                                <Button Content="افزودن دستهٔ هزینه" Click="AddExpenseCategory_Click" VerticalAlignment="Bottom"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="گزارش امروز" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="خروجی Excel گزارش‌ها" Click="ExportExcel_Click"/>
                                <Button Content="خروجی PDF گزارش‌ها" Click="ExportPdf_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="FinanceSummaryText" FontSize="16" TextWrapping="Wrap" LineHeight="34"/>
                            <TextBlock Text="مانده‌ها فقط از سندهای مالی ثبت‌شده در نسخهٔ جدید محاسبه می‌شوند؛ ماندهٔ افتتاحیه و رویدادهای قدیمی هنوز وارد نشده‌اند. سود، تخمینی و بر اساس بهای ثبت‌شده هنگام فروش است."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="هزینه‌های اخیر" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,10"/>
                    <DataGrid x:Name="ExpenseGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" Height="250">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="180"/>
                            <DataGridTextColumn Header="دسته" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="160"/>
                            <DataGridTextColumn Header="پرداخت" Binding="{Binding PaymentKind}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="AccountsPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="حساب بانکی" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="نام بانک" Foreground="{StaticResource MutedBrush}" Margin="3,8,3,0"/>
                            <TextBox x:Name="BankNameBox"/>
                            <TextBlock Text="نام صاحب حساب" Foreground="{StaticResource MutedBrush}" Margin="3,5,3,0"/>
                            <TextBox x:Name="BankTitleBox"/>
                            <TextBlock Text="شماره حساب" Foreground="{StaticResource MutedBrush}" Margin="3,5,3,0"/>
                            <TextBox x:Name="BankNumberBox"/>
                            <TextBlock Text="شماره کارت" Foreground="{StaticResource MutedBrush}" Margin="3,5,3,0"/>
                            <TextBox x:Name="BankCardBox"/>
                            <WrapPanel Margin="0,8,0,12">
                                <Button Content="افزودن حساب" Style="{StaticResource PrimaryButton}" Click="AddBank_Click"/>
                                <Button Content="غیرفعال‌سازی" Click="DeactivateBank_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <DataGrid x:Name="BankGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="بانک" Binding="{Binding BankName}" Width="*"/>
                                <DataGridTextColumn Header="صاحب حساب" Binding="{Binding AccountTitle}" Width="*"/>
                                <DataGridTextColumn Header="شماره کارت" Binding="{Binding CardNumber}" Width="135"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="کارتخوان" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="نام کارتخوان" Foreground="{StaticResource MutedBrush}" Margin="3,8,3,0"/>
                            <TextBox x:Name="PosNameBox"/>
                            <TextBlock Text="حساب بانکی مرتبط (اختیاری)" Foreground="{StaticResource MutedBrush}" Margin="3,5,3,0"/>
                            <ComboBox x:Name="PosBankBox" DisplayMemberPath="BankName" SelectedValuePath="Id"
                                      Margin="3,5" Height="38" ToolTip="حساب بانکی مرتبط (اختیاری)"/>
                            <TextBlock Text="شماره پایانه" Foreground="{StaticResource MutedBrush}" Margin="3,5,3,0"/>
                            <TextBox x:Name="PosTerminalBox"/>
                            <WrapPanel Margin="0,8,0,12">
                                <Button Content="افزودن کارتخوان" Style="{StaticResource PrimaryButton}" Click="AddPos_Click"/>
                                <Button Content="غیرفعال‌سازی" Click="DeactivatePos_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <DataGrid x:Name="PosGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="بانک" Binding="{Binding BankName}" Width="*"/>
                                <DataGridTextColumn Header="شماره پایانه" Binding="{Binding TerminalNumber}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="UsersPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="مدیریت کاربران" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="رمز هر حساب دست‌کم ۱۲ نویسه است. حساب آخرین مدیر غیرفعال نمی‌شود."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
                        <UniformGrid Columns="3">
                            <StackPanel><TextBlock Text="نام کاربری"/><TextBox x:Name="NewUsernameBox"/></StackPanel>
                            <StackPanel><TextBlock Text="رمز جدید"/><PasswordBox x:Name="NewUserPasswordBox" Height="38" Margin="3,5"/></StackPanel>
                            <StackPanel><TextBlock Text="نقش"/><ComboBox x:Name="NewUserRoleBox" SelectedIndex="1" Height="38" Margin="3,5">
                                <ComboBoxItem Content="مدیر"/><ComboBoxItem Content="صندوق‌دار"/><ComboBoxItem Content="انباردار"/>
                            </ComboBox></StackPanel>
                        </UniformGrid>
                        <WrapPanel Margin="0,9,0,0">
                            <Button Content="افزودن کاربر" Style="{StaticResource PrimaryButton}" Click="AddUser_Click"/>
                            <Button Content="بازنشانی رمز کاربر انتخاب‌شده" Click="ResetUserPassword_Click"/>
                            <Button Content="غیرفعال‌سازی انتخاب‌شده" Click="DeactivateUser_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="UserGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نام کاربری" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="نقش" Binding="{Binding RoleName}" Width="170"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" Background="White" CornerRadius="12" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="مالیات و کارمزد فاکتور" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="هرکدام می‌تواند غیرفعال، درصدی یا مبلغ ثابت باشد. مبلغ‌های تنظیم‌شده به فاکتور افزوده می‌شوند؛ در فروش هم می‌توان اعمال هرکدام را خاموش کرد."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                    <UniformGrid Columns="3">
                        <StackPanel><TextBlock Text="نوع مالیات"/><ComboBox x:Name="ChargeTaxModeBox" Height="38" Margin="3,5">
                            <ComboBoxItem Content="غیرفعال"/><ComboBoxItem Content="درصدی"/><ComboBoxItem Content="مبلغ ثابت"/>
                        </ComboBox></StackPanel>
                        <StackPanel><TextBlock Text="نرخ درصد یا مبلغ مالیات"/><TextBox x:Name="ChargeTaxValueBox" Text="0"/></StackPanel>
                        <StackPanel><TextBlock Text="مبنای مالیات"/><ComboBox x:Name="ChargeTaxBaseBox" Height="38" Margin="3,5">
                            <ComboBoxItem Content="پس از تخفیف"/><ComboBoxItem Content="پیش از تخفیف"/>
                        </ComboBox></StackPanel>
                        <StackPanel><TextBlock Text="نوع کارمزد"/><ComboBox x:Name="ChargeFeeModeBox" Height="38" Margin="3,5">
                            <ComboBoxItem Content="غیرفعال"/><ComboBoxItem Content="درصدی"/><ComboBoxItem Content="مبلغ ثابت"/>
                        </ComboBox></StackPanel>
                        <StackPanel><TextBlock Text="نرخ درصد یا مبلغ کارمزد"/><TextBox x:Name="ChargeFeeValueBox" Text="0"/></StackPanel>
                        <StackPanel><TextBlock Text="مبنای کارمزد"/><ComboBox x:Name="ChargeFeeBaseBox" Height="38" Margin="3,5">
                            <ComboBoxItem Content="پس از تخفیف"/><ComboBoxItem Content="پیش از تخفیف"/>
                        </ComboBox></StackPanel>
                        <StackPanel><TextBlock Text="گردکردن درصدها"/><ComboBox x:Name="ChargeRoundingBox" Height="38" Margin="3,5">
                            <ComboBoxItem Content="نزدیک‌ترین تومان"/><ComboBoxItem Content="رو به پایین"/><ComboBoxItem Content="رو به بالا"/>
                        </ComboBox></StackPanel>
                    </UniformGrid>
                    <Button Content="ذخیره تنظیمات مالیات و کارمزد" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Margin="0,12,0,20" Click="SaveChargeSettings_Click"/>
                    <Separator Margin="0,0,0,18"/>
                    <TextBlock Text="چاپ فیش و لیبل" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="نام چاپگر اختیاری است؛ هنگام چاپ، پنجرهٔ انتخاب چاپگر ویندوز باز می‌شود. بعد از تهیهٔ دستگاه، نام آن و عرض کاغذ را وارد کنید."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                    <UniformGrid Columns="4">
                        <StackPanel><TextBlock Text="نام فیش‌پرینتر"/><TextBox x:Name="ReceiptPrinterBox"/></StackPanel>
                        <StackPanel><TextBlock Text="عرض فیش (میلی‌متر)"/><TextBox x:Name="ReceiptWidthBox" Text="80"/></StackPanel>
                        <StackPanel><TextBlock Text="نام لیبل‌پرینتر"/><TextBox x:Name="LabelPrinterBox"/></StackPanel>
                        <StackPanel><TextBlock Text="عرض لیبل (میلی‌متر)"/><TextBox x:Name="LabelWidthBox" Text="50"/></StackPanel>
                    </UniformGrid>
                    <Button Content="ذخیره تنظیمات چاپ" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Margin="0,12,0,20" Click="SavePrintSettings_Click"/>
                    <Separator Margin="0,0,0,18"/>
                    <TextBlock Text="پشتیبان‌گیری از داده‌ها" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="یک نسخه سازگار از پایگاه داده در مسیر انتخابی شما ذخیره می‌شود."
                               Foreground="{StaticResource MutedBrush}" Margin="0,10,0,20"/>
                    <Button Content="ذخیره نسخه پشتیبان..." Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Click="Backup_Click"/>
                    <Button Content="بازیابی از فایل پشتیبان..." HorizontalAlignment="Right"
                            Margin="0,14,0,0" Click="Restore_Click"/>
                    <TextBlock Text="قبل از بازیابی، از داده‌های فعلی یک نسخهٔ ایمنی کنار فایل اصلی نگهداری می‌شود."
                               Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/>
                    <TextBlock x:Name="AutoBackupStatusText" Text="بررسی پشتیبان خودکار روزانه..."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/>
                    <TextBlock x:Name="DatabasePathText" Margin="0,22,0,0" Foreground="{StaticResource MutedBrush}"
                               FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid x:Name="DiagnosticsPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="125"/>
                </Grid.RowDefinitions>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="بررسی پایگاه داده، موجودی، پشتیبان و خطاهای برنامه" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="بررسی‌ها فقط وضعیت را گزارش می‌کنند و موجودی یا اسناد را خودکار تغییر نمی‌دهند. گزارش خروجی شامل دیتابیس یا رمز عبور نیست؛ قبل از فرستادن آن را مرور کنید."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,10"/>
                        <WrapPanel>
                            <Button Content="اجرای بررسی‌ها" Style="{StaticResource PrimaryButton}" Click="RunDiagnostics_Click"/>
                            <Button Content="ذخیره گزارش برای پشتیبانی..." Click="ExportDiagnostics_Click"/>
                            <Button Content="باز کردن پوشه خطاها" Click="OpenDiagnosticsFolder_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="DiagnosticsSummaryText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="DiagnosticsChecksGrid" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="بررسی" Binding="{Binding Name}" Width="140"/>
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="75"/>
                        <DataGridTemplateColumn Header="نتیجه" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="5,4"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="اقدام پیشنهادی" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Advice}" TextWrapping="Wrap" Margin="5,4"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="DiagnosticsErrorsGrid" Grid.Row="2" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" Margin="0,0,0,10"
                          SelectionChanged="DiagnosticsErrors_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="زمان" Binding="{Binding Time}" Width="165"/>
                        <DataGridTextColumn Header="شناسه" Binding="{Binding Id}" Width="190"/>
                        <DataGridTextColumn Header="عملیات" Binding="{Binding Operation}" Width="170"/>
                        <DataGridTextColumn Header="پیام" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBox x:Name="DiagnosticsDetailsBox" Grid.Row="3" IsReadOnly="True"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FlowDirection="LeftToRight"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
