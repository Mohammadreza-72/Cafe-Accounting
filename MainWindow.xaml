<Window x:Class="CafeArian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="کافه آرین - سیستم فروش و حسابداری"
        Width="1400" Height="850"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <StackPanel>
                <TextBlock Text="☕ کافه آرین"
                           Foreground="White"
                           FontSize="25"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,35"/>

                <Button Content="🏠  داشبورد" Click="Dashboard_Click"/>
                <Button Content="🛒  فروش جدید" Click="Sales_Click"/>
                <Button Content="📦  انبار"/>
                <Button Content="🧾  خرید"/>
                <Button Content="👥  مشتریان"/>
                <Button Content="💰  مالی"/>
                <Button Content="📊  گزارش‌ها"/>
                <Button Content="⚙  تنظیمات"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="فروش سریع"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="ClockText"
                           DockPanel.Dock="Left"
                           FontSize="14"
                           Margin="20,8,0,0"/>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="SearchBox"
                                 Height="45"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown"
                                 ToolTip="نام محصول یا بارکد را وارد کنید"/>

                        <TextBlock Grid.Row="1"
                                   Text="محصولات"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="5,15,0,10"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="ProductsPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="18"
                        Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="فاکتور جاری"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <ListView x:Name="CartList" Grid.Row="1" Margin="0,15,0,15">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="محصول" DisplayMemberBinding="{Binding ProductName}" Width="150"/>
                                    <GridViewColumn Header="تعداد" DisplayMemberBinding="{Binding Quantity}" Width="55"/>
                                    <GridViewColumn Header="مبلغ" DisplayMemberBinding="{Binding Total, StringFormat=N0}" Width="90"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Row="2">
                            <DockPanel Margin="0,4">
                                <TextBlock Text="جمع فاکتور" FontSize="16"/>
                                <TextBlock x:Name="SubtotalText" DockPanel.Dock="Left" FontWeight="Bold" FontSize="17"/>
                            </DockPanel>

                            <DockPanel Margin="0,4">
                                <TextBlock Text="تخفیف" FontSize="16"/>
                                <TextBox x:Name="DiscountBox" DockPanel.Dock="Left" Width="120" Text="0"
                                         TextChanged="DiscountBox_TextChanged"/>
                            </DockPanel>

                            <DockPanel Margin="0,8">
                                <TextBlock Text="مبلغ نهایی" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="FinalText" DockPanel.Dock="Left"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </DockPanel>

                            <TextBox x:Name="MobileBox"
                                     Height="42"
                                     Margin="0,8,0,4"
                                     ToolTip="شماره مشتری - اختیاری"
                                     Text=""/>

                            <Button Content="ثبت و چاپ فاکتور"
                                    Height="52"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Click="Checkout_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
