<Window x:Class="CafeArian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="کافه آرین | مدیریت فروش" Icon="/Assets/arian-logo.png"
        Width="1360" Height="820" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Bottom" Text="نسخه آفلاین • داده‌ها روی همین دستگاه"
                           Foreground="#9DA2A5" FontSize="11" Margin="15,12,15,22" TextAlignment="Center"/>
                <StackPanel>
                    <Border Background="White" CornerRadius="12" Margin="20,24,20,12" Height="105" ClipToBounds="True">
                        <Image Stretch="Uniform">
                            <Image.Source>
                                <CroppedBitmap SourceRect="90,280,1070,640">
                                    <CroppedBitmap.Source>
                                        <BitmapImage UriSource="/Assets/arian-logo.png"/>
                                    </CroppedBitmap.Source>
                                </CroppedBitmap>
                            </Image.Source>
                        </Image>
                    </Border>
                    <TextBlock Text="ARIAN CAFFE" Foreground="White" FontSize="17" FontWeight="Bold"
                               TextAlignment="Center" FlowDirection="LeftToRight" Margin="0,0,0,22"/>
                    <Button x:Name="DashboardNav" Style="{StaticResource NavButton}" Content="داشبورد" Click="Dashboard_Click"/>
                    <Button x:Name="SalesNav" Style="{StaticResource NavButton}" Content="فروش سریع" Click="Sales_Click"/>
                    <Button x:Name="ProductsNav" Style="{StaticResource NavButton}" Content="محصولات" Click="Products_Click"/>
                    <Button x:Name="RecipesNav" Style="{StaticResource NavButton}" Content="دستور تهیه" Click="Recipes_Click"/>
                    <Button x:Name="BatchesNav" Style="{StaticResource NavButton}" Content="بچ و انقضا" Click="Batches_Click"/>
                    <Button x:Name="InventoryNav" Style="{StaticResource NavButton}" Content="خرید و موجودی" Click="Inventory_Click"/>
                    <Button x:Name="CustomersNav" Style="{StaticResource NavButton}" Content="مشتریان" Click="Customers_Click"/>
                    <Button x:Name="HistoryNav" Style="{StaticResource NavButton}" Content="فاکتورها" Click="History_Click"/>
                    <Button x:Name="FinanceNav" Style="{StaticResource NavButton}" Content="مالی و گزارش" Click="Finance_Click"/>
                    <Button x:Name="AccountsNav" Style="{StaticResource NavButton}" Content="حساب‌ها و کارتخوان‌ها" Click="Accounts_Click"/>
                    <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="پشتیبان‌گیری" Click="Settings_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,25">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Right">
                    <TextBlock x:Name="PageTitle" Text="داشبورد" FontSize="27" FontWeight="Bold"/>
                    <TextBlock x:Name="PageSubtitle" Text="مرور وضعیت امروز کافه" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ClockText" DockPanel.Dock="Left" HorizontalAlignment="Left"
                           Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
            </DockPanel>

            <ScrollViewer x:Name="DashboardPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <UniformGrid Columns="4" Margin="0,0,0,18">
                        <Border Background="White" CornerRadius="12" Margin="4" Padding="20">
                            <StackPanel><TextBlock Text="فروش امروز" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="TodaySalesText" FontSize="23" FontWeight="Bold" Margin="0,12,0,0"/></StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" Margin="4" Padding="20">
                            <StackPanel><TextBlock Text="هزینه امروز" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="TodayExpensesText" FontSize="23" FontWeight="Bold" Margin="0,12,0,0"/></StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" Margin="4" Padding="20">
                            <StackPanel><TextBlock Text="سود تخمینی امروز" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="TodayProfitText" FontSize="23" FontWeight="Bold" Margin="0,12,0,0"/></StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" Margin="4" Padding="20">
                            <StackPanel><TextBlock Text="کالاهای کم‌موجودی" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="LowStockText" FontSize="23" FontWeight="Bold" Margin="0,12,0,0"/></StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Background="White" CornerRadius="12" Padding="25">
                        <StackPanel>
                            <TextBlock Text="شروع سریع" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="محصولات کافه را تعریف کنید، موجودی را با ثبت خرید افزایش دهید و فروش را از صفحه فروش سریع انجام دهید."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                            <WrapPanel Margin="0,18,0,0">
                                <Button Content="فروش جدید  F1" Style="{StaticResource PrimaryButton}" Click="Sales_Click"/>
                                <Button Content="تعریف محصول" Click="Products_Click"/>
                                <Button Content="ثبت خرید" Click="Inventory_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="22" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="فروش هفت روز اخیر" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                <ItemsControl x:Name="WeeklySalesChart">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding Amount, StringFormat=N0}" FontSize="11"
                                                           TextAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                                <Grid Height="120">
                                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="5,5,0,0"
                                                            Width="28" Height="{Binding BarHeight}" VerticalAlignment="Bottom"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Label}" TextAlignment="Center" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="22" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="هشدار موجودی" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                <ItemsControl x:Name="LowStockList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Text="{Binding Stock, StringFormat=موجودی {0:N0}}"
                                                           DockPanel.Dock="Left" Foreground="{StaticResource AccentBrush}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoLowStockText" Text="موردی ثبت نشده است."
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="SalesPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="جستجوی نام یا بارکد" Foreground="{StaticResource MutedBrush}" Margin="3,0,3,3"/>
                            <TextBox x:Name="SearchBox" Height="44" ToolTip="نام یا بارکد محصول" TextChanged="SearchBox_TextChanged"
                                     KeyDown="SearchBox_KeyDown"/>
                        </StackPanel>
                        <DockPanel Grid.Row="1" LastChildFill="False" Margin="5,12,5,12">
                            <TextBlock Text="محصولات" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ProductsHint" DockPanel.Dock="Left" Margin="14,5,0,0"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="ProductsWrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="فاکتور جاری" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Left" Content="حذف قلم" Click="RemoveItem_Click" Padding="8,4"/>
                            <Button DockPanel.Dock="Left" Content="−" Click="DecreaseItem_Click" Padding="8,4"/>
                            <Button DockPanel.Dock="Left" Content="+" Click="IncreaseItem_Click" Padding="8,4"/>
                        </DockPanel>
                        <DataGrid x:Name="CartList" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  Margin="0,12" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="محصول" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity}" Width="60"/>
                                <DataGridTextColumn Header="مبلغ" Binding="{Binding Total, StringFormat=N0}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2">
                            <DockPanel Margin="3,3"><TextBlock Text="جمع" FontSize="15"/>
                                <TextBlock x:Name="SubtotalText" DockPanel.Dock="Left" FontWeight="Bold"/></DockPanel>
                            <TextBlock Text="تخفیف (تومان)" Foreground="{StaticResource MutedBrush}" Margin="3,8,3,0"/>
                            <TextBox x:Name="DiscountBox" Text="0" TextChanged="DiscountBox_TextChanged"/>
                            <DockPanel Margin="3,7"><TextBlock Text="مبلغ نهایی" FontSize="18" FontWeight="Bold"/>
                                <TextBlock x:Name="FinalText" DockPanel.Dock="Left" Foreground="{StaticResource AccentBrush}"
                                           FontSize="20" FontWeight="Bold"/></DockPanel>
                            <TextBlock Text="موبایل مشتری (اختیاری)" Foreground="{StaticResource MutedBrush}" Margin="3,7,3,0"/>
                            <TextBox x:Name="MobileBox"/>
                            <UniformGrid Columns="3" Margin="0,7,0,0">
                                <StackPanel><TextBlock Text="نقدی" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="CashBox" ToolTip="مانده نقدی (خودکار)" Text="0" IsReadOnly="True"/></StackPanel>
                                <StackPanel><TextBlock Text="کارتخوان" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="CardBox" Text="0" TextChanged="PaymentBox_TextChanged"/></StackPanel>
                                <StackPanel><TextBlock Text="کارت به کارت" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="TransferBox" Text="0" TextChanged="PaymentBox_TextChanged"/></StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <TextBlock Text="کارتخوان انتخابی (اختیاری)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="3,2"/>
                                <TextBlock Text="حساب مقصد کارت به کارت (اختیاری)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="3,2"/>
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <ComboBox x:Name="PosDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          Margin="3,3" Height="32" ToolTip="کارتخوان ثبت‌شده (اختیاری)"/>
                                <ComboBox x:Name="TransferBankBox" DisplayMemberPath="BankName" SelectedValuePath="Id"
                                          Margin="3,3" Height="32" ToolTip="حساب مقصد کارت به کارت (اختیاری)"/>
                            </UniformGrid>
                            <TextBlock x:Name="PaymentHint" Foreground="{StaticResource MutedBrush}" Margin="3,3,3,8"/>
                            <Button Content="ثبت فاکتور  F5" Style="{StaticResource PrimaryButton}" Height="48" Click="Checkout_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ProductsPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="تعریف یا ویرایش محصول" FontSize="18" FontWeight="SemiBold"/>
                        <UniformGrid Columns="7" Margin="0,12,0,0">
                            <StackPanel><TextBlock Text="نام"/><TextBox x:Name="ProductNameBox"/></StackPanel>
                            <StackPanel><TextBlock Text="بارکد"/><TextBox x:Name="ProductBarcodeBox"/></StackPanel>
                            <StackPanel><TextBlock Text="قیمت فروش"/><TextBox x:Name="ProductSaleBox"/></StackPanel>
                            <StackPanel><TextBlock Text="بهای خرید"/><TextBox x:Name="ProductCostBox"/></StackPanel>
                            <StackPanel><TextBlock Text="حداقل موجودی"/><TextBox x:Name="ProductMinimumBox" Text="0"/></StackPanel>
                            <StackPanel><TextBlock Text="واحد"/><TextBox x:Name="ProductUnitBox" Text="عدد"/></StackPanel>
                            <StackPanel><TextBlock Text="نوع"/>
                                <ComboBox x:Name="ProductTypeBox" SelectedIndex="0" Margin="3,5" Height="38">
                                    <ComboBoxItem Content="کالای فروشی" Tag="1"/>
                                    <ComboBoxItem Content="ماده اولیه" Tag="2"/>
                                    <ComboBoxItem Content="آماده‌شونده" Tag="3"/>
                                    <ComboBoxItem Content="یخچالی" Tag="4"/>
                                </ComboBox>
                            </StackPanel>
                        </UniformGrid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="ذخیره محصول" Style="{StaticResource PrimaryButton}" Click="SaveProduct_Click"/>
                            <Button Content="فرم جدید" Click="NewProduct_Click"/>
                            <Button Content="غیرفعال‌سازی انتخاب‌شده" Click="DeactivateProduct_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="ProductGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionChanged="ProductGrid_SelectionChanged" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="نوع" Binding="{Binding ProductTypeName}" Width="120"/>
                        <DataGridTextColumn Header="واحد" Binding="{Binding UnitName}" Width="70"/>
                        <DataGridTextColumn Header="بارکد" Binding="{Binding Barcode}" Width="130"/>
                        <DataGridTextColumn Header="قیمت فروش" Binding="{Binding SalePrice, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="بهای پایه" Binding="{Binding CostPrice, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="موجودی" Binding="{Binding Stock}" Width="90"/>
                        <DataGridTextColumn Header="حداقل" Binding="{Binding MinimumStock}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="RecipesPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="مواد مصرفی هر واحد محصول" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="برای محصول آماده‌شونده یا یخچالی، مقدار ماده اولیه برای هر واحد را تعریف کنید."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
                        <UniformGrid Columns="3">
                            <StackPanel><TextBlock Text="محصول تولیدی / یخچالی"/>
                                <ComboBox x:Name="RecipeProductBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectionChanged="RecipeProduct_SelectionChanged" Height="38" Margin="3,5"/></StackPanel>
                            <StackPanel><TextBlock Text="ماده اولیه"/>
                                <ComboBox x:Name="RecipeIngredientBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          Height="38" Margin="3,5"/></StackPanel>
                            <StackPanel><TextBlock Text="مقدار برای یک واحد محصول"/>
                                <TextBox x:Name="RecipeQuantityBox" ToolTip="مثلاً 18 گرم یا 0.2 لیتر، مطابق واحد ماده اولیه"/></StackPanel>
                        </UniformGrid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="افزودن یا ویرایش ماده" Style="{StaticResource PrimaryButton}" Click="SaveRecipeItem_Click"/>
                            <Button Content="حذف ماده انتخاب‌شده" Click="RemoveRecipeItem_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="RecipeCostText" Grid.Row="1" FontSize="17" FontWeight="SemiBold" Margin="5,0,5,12"/>
                <DataGrid x:Name="RecipeGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ماده اولیه" Binding="{Binding IngredientName}" Width="*"/>
                        <DataGridTextColumn Header="مقدار" Binding="{Binding QuantityDisplay}" Width="150"/>
                        <DataGridTextColumn Header="میانگین بهای واحد" Binding="{Binding UnitCost, StringFormat=N0}" Width="170"/>
                        <DataGridTextColumn Header="بهای مصرف" Binding="{Binding LineCost, StringFormat=N0}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="BatchesPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ثبت بچ محصول یخچالی" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="موجودی قابل فروش از بچ‌های دارای تاریخ معتبر محاسبه می‌شود. بارکد بچ برای اسکن اختیاری است."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
                        <UniformGrid Columns="4">
                            <StackPanel><TextBlock Text="محصول"/><ComboBox x:Name="BatchProductBox" DisplayMemberPath="Name" Height="38" Margin="3,5"/></StackPanel>
                            <StackPanel><TextBlock Text="شماره بچ"/><TextBox x:Name="BatchNumberBox"/></StackPanel>
                            <StackPanel><TextBlock Text="بارکد بچ (اختیاری)"/><TextBox x:Name="BatchBarcodeBox"/></StackPanel>
                            <StackPanel><TextBlock Text="منبع / تولیدکننده"/><TextBox x:Name="BatchSourceBox"/></StackPanel>
                            <StackPanel><TextBlock Text="تاریخ تولید"/><DatePicker x:Name="BatchProducedPicker" Margin="3,5" Height="38"/></StackPanel>
                            <StackPanel><TextBlock Text="تاریخ انقضا"/><DatePicker x:Name="BatchExpiryPicker" Margin="3,5" Height="38"/></StackPanel>
                            <StackPanel><TextBlock Text="مقدار"/><TextBox x:Name="BatchQuantityBox"/></StackPanel>
                            <StackPanel><TextBlock Text="بهای واحد برای ورود مستقیم (تومان)"/><TextBox x:Name="BatchCostBox"/></StackPanel>
                        </UniformGrid>
                        <CheckBox x:Name="BatchProductionCheck" Content="تولید از دستور تهیه؛ بهای واحد از مواد محاسبه شود" Margin="3,8"/>
                        <Button Content="ثبت بچ و افزایش موجودی" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                Margin="0,10,0,0" Click="RegisterBatch_Click"/>
                    </StackPanel>
                </Border>
                <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button Content="ثبت ضایعات بچ انتخاب‌شده" Click="DiscardBatch_Click"/>
                    <TextBlock Text="برای بچ منقضی یا آسیب‌دیده، مقدار باقی‌مانده را از موجودی خارج کنید."
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="12,0"/>
                </WrapPanel>
                <DataGrid x:Name="BatchGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="محصول" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="بچ" Binding="{Binding BatchNumber}" Width="130"/>
                        <DataGridTextColumn Header="بارکد" Binding="{Binding Barcode}" Width="130"/>
                        <DataGridTextColumn Header="منبع" Binding="{Binding Source}" Width="150"/>
                        <DataGridTextColumn Header="تولید" Binding="{Binding ProducedAt}" Width="110"/>
                        <DataGridTextColumn Header="انقضا" Binding="{Binding ExpiresAt}" Width="110"/>
                        <DataGridTextColumn Header="مقدار" Binding="{Binding Quantity}" Width="90"/>
                        <DataGridTextColumn Header="بهای واحد" Binding="{Binding UnitCost, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="InventoryPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ثبت خرید و ورود موجودی" FontSize="18" FontWeight="SemiBold"/>
                        <UniformGrid Columns="5" Margin="0,12,0,0">
                            <StackPanel><TextBlock Text="محصول"/><ComboBox x:Name="PurchaseProductBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="3,5" Height="38"/></StackPanel>
                            <StackPanel><TextBlock Text="تأمین‌کننده"/><TextBox x:Name="SupplierBox"/></StackPanel>
                            <StackPanel><TextBlock Text="شماره سند"/><TextBox x:Name="PurchaseInvoiceBox"/></StackPanel>
                            <StackPanel><TextBlock Text="مقدار"/><TextBox x:Name="PurchaseQuantityBox"/></StackPanel>
                            <StackPanel><TextBlock Text="قیمت واحد"/><TextBox x:Name="PurchaseCostBox"/></StackPanel>
                        </UniformGrid>
                        <Button Content="ثبت خرید و افزایش موجودی" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" Margin="0,10,0,0" Click="Purchase_Click"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="اصلاح موجودی یا ثبت ضایعات" FontSize="16" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,8,0,0">
                            <ComboBox x:Name="AdjustmentProductBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      Width="240" Height="38" Margin="3,5" ToolTip="محصول یا ماده اولیه"/>
                            <TextBox x:Name="AdjustmentDeltaBox" Width="170" ToolTip="مقدار تغییر؛ برای ضایعات عدد منفی"/>
                            <TextBox x:Name="AdjustmentReasonBox" Width="300" ToolTip="علت اصلاح"/>
                            <Button Content="ثبت اصلاح" Click="Adjustment_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TabControl Grid.Row="2">
                    <TabItem Header="موجودی">
                        <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="محصول" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="موجودی" Binding="{Binding Stock}" Width="140"/>
                                <DataGridTextColumn Header="حداقل مجاز" Binding="{Binding MinimumStock}" Width="140"/>
                                <DataGridTextColumn Header="میانگین بهای خرید" Binding="{Binding AverageCost, StringFormat=N0}" Width="170"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="سوابق خرید">
                        <DataGrid x:Name="PurchaseGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="شماره" Binding="{Binding Id}" Width="90"/>
                                <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="170"/>
                                <DataGridTextColumn Header="تأمین‌کننده" Binding="{Binding Supplier}" Width="*"/>
                                <DataGridTextColumn Header="شماره سند" Binding="{Binding InvoiceNumber}" Width="150"/>
                                <DataGridTextColumn Header="مبلغ" Binding="{Binding Total, StringFormat=N0}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>

            <Grid x:Name="CustomersPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ثبت مشتری" FontSize="18" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,12,0,0">
                            <TextBox x:Name="CustomerNameBox" Width="220" ToolTip="نام مشتری"/>
                            <TextBox x:Name="CustomerMobileBox" Width="180" ToolTip="شماره موبایل"/>
                            <Button Content="ذخیره مشتری" Style="{StaticResource PrimaryButton}" Click="SaveCustomer_Click"/>
                            <TextBox x:Name="CustomerSearchBox" Width="230" ToolTip="جستجوی نام یا موبایل" TextChanged="CustomerSearch_TextChanged"/>
                            <Button Content="سوابق خرید مشتری" Click="CustomerHistory_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="CustomerGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نام" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="180"/>
                        <DataGridTextColumn Header="تعداد خرید" Binding="{Binding TotalOrders}" Width="120"/>
                        <DataGridTextColumn Header="جمع خرید" Binding="{Binding TotalPurchase, StringFormat=N0}" Width="150"/>
                        <DataGridTextColumn Header="جمع تخفیف" Binding="{Binding TotalDiscount, StringFormat=N0}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <TextBox x:Name="HistorySearchBox" Width="300" ToolTip="جستجوی فاکتور، تاریخ، مشتری یا مبلغ"
                             TextChanged="HistorySearch_TextChanged"/>
                    <Button Content="چاپ فاکتور انتخاب‌شده" Click="PrintSelected_Click"/>
                    <Button Content="لغو فاکتور انتخاب‌شده" Click="CancelSelected_Click"/>
                    <Button Content="خروجی CSV" Click="ExportSales_Click"/>
                </DockPanel>
                <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="شماره" Binding="{Binding InvoiceNumber}" Width="135"/>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="160"/>
                        <DataGridTextColumn Header="مشتری" Binding="{Binding Customer}" Width="*"/>
                        <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="135"/>
                        <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="125"/>
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <ScrollViewer x:Name="FinancePage" Grid.Row="1" Visibility="Collapsed">
                <StackPanel>
                    <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ثبت هزینه" FontSize="18" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,12,0,0">
                                <TextBox x:Name="ExpenseDescriptionBox" Width="350" ToolTip="شرح هزینه"/>
                                <TextBox x:Name="ExpenseAmountBox" Width="180" ToolTip="مبلغ به تومان"/>
                                <Button Content="ثبت هزینه" Style="{StaticResource PrimaryButton}" Click="Expense_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="گزارش امروز" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            <TextBlock x:Name="FinanceSummaryText" FontSize="16" TextWrapping="Wrap" LineHeight="34"/>
                            <TextBlock Text="سود بر اساس بهای ثبت‌شده محصول در زمان فروش محاسبه می‌شود. مالیات، بدهی، مانده بانک و هزینه‌های خرید در این نسخه در سود خالص منظور نشده‌اند."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="هزینه‌های اخیر" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,10"/>
                    <DataGrid x:Name="ExpenseGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" Height="250">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="180"/>
                            <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="AccountsPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="حساب بانکی" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="نام بانک" Foreground="{StaticResource MutedBrush}" Margin="3,8,3,0"/>
                            <TextBox x:Name="BankNameBox"/>
                            <TextBlock Text="نام صاحب حساب" Foreground="{StaticResource MutedBrush}" Margin="3,5,3,0"/>
                            <TextBox x:Name="BankTitleBox"/>
                            <TextBlock Text="شماره حساب" Foreground="{StaticResource MutedBrush}" Margin="3,5,3,0"/>
                            <TextBox x:Name="BankNumberBox"/>
                            <TextBlock Text="شماره کارت" Foreground="{StaticResource MutedBrush}" Margin="3,5,3,0"/>
                            <TextBox x:Name="BankCardBox"/>
                            <WrapPanel Margin="0,8,0,12">
                                <Button Content="افزودن حساب" Style="{StaticResource PrimaryButton}" Click="AddBank_Click"/>
                                <Button Content="غیرفعال‌سازی" Click="DeactivateBank_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <DataGrid x:Name="BankGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="بانک" Binding="{Binding BankName}" Width="*"/>
                                <DataGridTextColumn Header="صاحب حساب" Binding="{Binding AccountTitle}" Width="*"/>
                                <DataGridTextColumn Header="شماره کارت" Binding="{Binding CardNumber}" Width="135"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="کارتخوان" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="نام کارتخوان" Foreground="{StaticResource MutedBrush}" Margin="3,8,3,0"/>
                            <TextBox x:Name="PosNameBox"/>
                            <TextBlock Text="حساب بانکی مرتبط (اختیاری)" Foreground="{StaticResource MutedBrush}" Margin="3,5,3,0"/>
                            <ComboBox x:Name="PosBankBox" DisplayMemberPath="BankName" SelectedValuePath="Id"
                                      Margin="3,5" Height="38" ToolTip="حساب بانکی مرتبط (اختیاری)"/>
                            <TextBlock Text="شماره پایانه" Foreground="{StaticResource MutedBrush}" Margin="3,5,3,0"/>
                            <TextBox x:Name="PosTerminalBox"/>
                            <WrapPanel Margin="0,8,0,12">
                                <Button Content="افزودن کارتخوان" Style="{StaticResource PrimaryButton}" Click="AddPos_Click"/>
                                <Button Content="غیرفعال‌سازی" Click="DeactivatePos_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <DataGrid x:Name="PosGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="بانک" Binding="{Binding BankName}" Width="*"/>
                                <DataGridTextColumn Header="شماره پایانه" Binding="{Binding TerminalNumber}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" Background="White" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="پشتیبان‌گیری از داده‌ها" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="یک نسخه سازگار از پایگاه داده در مسیر انتخابی شما ذخیره می‌شود."
                               Foreground="{StaticResource MutedBrush}" Margin="0,10,0,20"/>
                    <Button Content="ذخیره نسخه پشتیبان..." Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Click="Backup_Click"/>
                    <Button Content="بازیابی از فایل پشتیبان..." HorizontalAlignment="Right"
                            Margin="0,14,0,0" Click="Restore_Click"/>
                    <TextBlock Text="قبل از بازیابی، از داده‌های فعلی یک نسخهٔ ایمنی کنار فایل اصلی نگهداری می‌شود."
                               Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/>
                    <TextBlock x:Name="DatabasePathText" Margin="0,22,0,0" Foreground="{StaticResource MutedBrush}"
                               FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
